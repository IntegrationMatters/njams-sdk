<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.salesfive.njams</groupId>
        <artifactId>njams-sdk-jms-namespace-tests</artifactId>
        <version>6.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>njams-sdk-jms-mixed-test</artifactId>
    <name>njams-sdk-jms-mixed-test</name>
    <packaging>jar</packaging>
    <description>
        Both JMS APIs and two different broker products at once: ActiveMQ Classic on javax, Artemis on jakarta.
        This classpath is only buildable because the two products' class names do not collide - unlike
        activemq-client and activemq-client-jakarta, which do.
    </description>

    <dependencies>
        <dependency>
            <groupId>javax.jms</groupId>
            <artifactId>javax.jms-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>activemq-client</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- ActiveMQ Classic pulls jakarta.jms-api 2.0.3, which shares its coordinates with the
                     3.x jakarta API below and would silently displace it. -->
                <exclusion>
                    <groupId>jakarta.jms</groupId>
                    <artifactId>jakarta.jms-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>jakarta.jms</groupId>
            <artifactId>jakarta.jms-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.activemq</groupId>
            <artifactId>artemis-jakarta-client</artifactId>
            <version>${artemis.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
