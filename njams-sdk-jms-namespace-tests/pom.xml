<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.salesfive.njams</groupId>
        <artifactId>njams-sdk-root</artifactId>
        <version>6.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>njams-sdk-jms-namespace-tests</artifactId>
    <name>njams-sdk-jms-namespace-tests</name>
    <packaging>pom</packaging>
    <description>
        Broker-less test harnesses proving that the SDK selects the right JMS implementation for the JMS API
        actually present. Each child carries one classpath; njams-sdk declares both JMS APIs as provided, so
        nothing of either namespace reaches a child it did not ask for.
    </description>

    <modules>
        <module>njams-sdk-jms-javax-test</module>
        <module>njams-sdk-jms-jakarta-test</module>
        <module>njams-sdk-jms-absent-test</module>
        <module>njams-sdk-jms-mixed-test</module>
    </modules>

    <properties>
        <!-- Test harness modules: built and run on every build, but never published. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <build>
        <!-- Inherited by the children. The first entry repeats the root pom's own test resources, which
             declaring this element here would otherwise replace; the second adds this aggregator's shared
             simplelogger.properties, so the JMS logging configuration lives in one place instead of being
             copied into every child. The path is relative to each child's own directory, which is why it
             starts with "..": Maven does not interpolate ${project.parent.basedir} inside <directory>. -->
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <filtering>true</filtering>
            </testResource>
            <testResource>
                <directory>../src/test/resources-shared</directory>
            </testResource>
        </testResources>
    </build>

    <dependencies>
        <!-- The artifact under test. Deliberately NOT its test-jar: that would register additional senders,
             receivers and JmsFactory fixtures via SPI and so corrupt the very lookup these modules measure. -->
        <dependency>
            <groupId>com.salesfive.njams</groupId>
            <artifactId>njams-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- provided in njams-sdk, so every consumer supplies its own binding -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
